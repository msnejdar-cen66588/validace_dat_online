# ═══════════════════════════════════════════════════════════════════════════════
# AI Validation Pipeline – Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
#
# For Windows PowerShell:
#   Copy-Item .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── POVINNÉ ──────────────────────────────────────────────────────────────────
# Hlavní AI model (Gemini). Bez tohoto klíče pipeline nepůjde spustit.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── VOLITELNÉ – externí služby ───────────────────────────────────────────────
# Mapy.cz API pro geolokaci a panorama
MAPY_CZ_API_KEY=

# Google Cloud Vision (pro forenzní analýzu fotografií)
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json
# Alternativně: inline JSON credentials
# GOOGLE_CREDENTIALS_JSON=

# OpenAI / Azure OpenAI (alternativní LLM provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_VERSION=

# ČS AI Gateway (interní podnikový endpoint)
# OPENAI_API_KEY=f6002230db3b4e0581201a2e0f8ae271
# OPENAI_BASE_URL=https://dev-be.api.csint.cz/be/v1/aigateway-shared-gpt-5
# OPENAI_MODEL=gpt-4o
# OPENAI_API_VERSION=2024-08-01-preview

# ── FEATURE FLAGS ────────────────────────────────────────────────────────────
# Vypněte pokud služby nejsou dostupné (offline / restricted network)
ENABLE_MAPS_API=true
ENABLE_VALUATION=true
ENABLE_EXTERNAL_SERVICES=true

# ── CORPORATE PROXY / TLS ───────────────────────────────────────────────────
# Nastavte pokud jste za corporate proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.bank.cz

# Custom CA certifikát (pro TLS inspection)
# SSL_CERT_FILE=C:\certs\corporate-ca-bundle.pem
# REQUESTS_CA_BUNDLE=C:\certs\corporate-ca-bundle.pem

# Vypněte SSL verifikaci POUZE pro debug (NEBEZPEČNÉ v produkci!)
# VERIFY_SSL=false
